# Sources and tooling are not needed at runtime: out/extension.js is self-contained.
src/**
test/**
scripts/**
docs/**
tmp/**
.github/**
.husky/**
.vscode/**

# Dependencies are bundled into out/extension.js by esbuild.
node_modules/**

# Config and metadata
tsconfig.json
eslint.config.mjs
.prettierrc.json
.prettierignore
.npmrc
.gitignore
*.code-workspace

# Lockfiles and logs
package-lock.json
npm-debug.log*
*.log

# Build artifacts that must not be shipped
*.vsix
*.zip
pin-context.zip

# OS junk
.DS_Store
__MACOSX/**
Thumbs.db

# Repo-only docs
IMPROVEMENTS.md
CHANGELOG.md
architecture.md
RELEASE.md
AGENTS.md
